{
  "name": "obsidian-tv-progress-sync",
  "version": "1.0.1",
  "description": "An Obsidian plugin that synchronizes Seen state across TV series, seasons, and episodes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src --max-warnings=0",
    "test": "npm run lint && npm run build && node test/cascade.cjs"
  },
  "keywords": [
    "obsidian",
    "television",
    "tracking",
    "progress"
  ],
  "license": "MIT",
  "author": "Jim Ezesinachi",
  "repository": {
    "type": "git",
    "url": "https://github.com/jimezesinachi/obsidian-tv-progress-sync.git"
  },
  "homepage": "https://github.com/jimezesinachi/obsidian-tv-progress-sync#readme",
  "bugs": {
    "url": "https://github.com/jimezesinachi/obsidian-tv-progress-sync/issues"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "latest",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "typescript": "latest"
  }
}
